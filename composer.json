{
    "name": "frontastic/common",
    "license": "None",
    "version": "2.51.0",
    "repositories": [
        {
            "type": "path",
            "url": "../*"
        }
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "conflict": {
        "algolia/algoliasearch-client-php": "<4.0 || >=5.0",
        "frontastic/catwalk": "<1.68.0"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ackintosh/ganesha": "^1.2",
        "beberlei/assert": "^3.2",
        "behat/transliterator": "^1.3",
        "cloudinary/cloudinary_php": "^1.8",
        "contentful/contentful": "^7.0",
        "doctrine/cache": "^1.13||^2.2",
        "slickdeals/statsd": "^2.6",
        "frontastic/data-object": "@stable",
        "guzzlehttp/guzzle": "^7",
        "guzzlehttp/promises": "^1.5|^2.0",
        "justinrainbow/json-schema": "^5",
        "league/oauth2-client": "^2.3",
        "myclabs/deep-copy": "^1.0",
        "psr/simple-cache": "^1.0||^2.0||^3.0",
        "ramsey/uuid": "^4",
        "seld/jsonlint": "@stable",
        "symfony/mailer": "^6.4||^7.4",
        "symfony/config": "^6.4||^7.4",
        "symfony/console": "^6.4||^7.4",
        "symfony/dependency-injection": "^6.4||^7.4",
        "symfony/dotenv": "^6.4||^7.4",
        "symfony/event-dispatcher": "^6.4||^7.4",
        "symfony/expression-language": "^6.4||^7.4",
        "symfony/finder": "^6.4||^7.4",
        "symfony/form": "^6.4||^7.4",
        "symfony/framework-bundle": "^6.4||^7.4",
        "symfony/http-kernel": "^6.4||^7.4",
        "symfony/routing": "^6.4||^7.4",
        "symfony/security-core": "^6.4||^7.4",
        "symfony/yaml": "^6.4||^7.4",
        "twig/twig": "^3.0",
        "woohoolabs/yang": "^2.3"
    },
    "require-dev": {
        "doctrine/collections": "^1.0|^2.0",
        "doctrine/common": "^3.0",
        "pdepend/pdepend": "@stable",
        "phake/phake": "^4.0",
        "phpmd/phpmd": "@stable",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10",
        "squizlabs/php_codesniffer": "@stable",
        "symfony/phpunit-bridge": "^6.4||^7.4",
        "symfony/twig-bundle": "^6.4||^7.4"
    },
    "suggest": {
        "algolia/algoliasearch-client-php": "Required for the Algolia search integration"
    },
    "autoload": {
        "psr-4": {
            "Frontastic\\Common\\": "src/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Frontastic\\Common\\": "test/php/",
            "Frontastic\\Common\\ApiTests\\": "test/api/"
        }
    },
    "scripts": {
        "phpstan": [
            "vendor/bin/phpstan analyze --ansi -c phpstan.neon src/php/"
        ],
        "api-tests": [
            "phpunit --configuration phpunit.api.xml --colors=always"
        ],
        "api-tests-debug": [
            "php -dxdebug.remote_autostart=1 vendor/bin/phpunit --configuration phpunit.api.xml --colors=always"
        ]
    }
}
